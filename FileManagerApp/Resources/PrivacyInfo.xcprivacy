<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Privacy Manifest, required by App Store since May 2024.

	  Tracking: We do not perform user tracking. The app talks to the
	  user's own NAS and to the iOS Photos library. There is no
	  analytics SDK, no ad SDK, and no remote attribution. We never
	  link a user identifier across apps or websites.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Collected data: none. The app does not transmit any data to
	  servers we control. All file content stays on the user's device
	  or on their own server.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required Reason API declarations. Apple requires us to declare
	  every category of API our binary or its embedded frameworks
	  call. Reason codes come from
	  https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from the same app, same group, or App Clip. -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: display modification dates to the user
				     who initiated the file access (file browser rows). -->
				<string>C617.1</string>
				<!-- 3B52.1: read mtimes for files inside the app's
				     own container during pin-sync to skip already-synced files. -->
				<string>3B52.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1: display free disk space to the user
				     (Settings → Storage cache size row). -->
				<string>E174.1</string>
				<!-- 85F4.1: prevent writes that would exhaust the disk
				     during downloads / photo backup. Triggered by
				     Kingfisher's disk-cache eviction code path. -->
				<string>85F4.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1: measure elapsed time between in-app events.
				     Foundation timers, AVFoundation playback, transfer
				     progress, and the SFTP / SMB libraries all read
				     mach_absolute_time and ProcessInfo.systemUptime. -->
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
